def set_seed(seed=1234):
    os.environ["PYTHONHASHSEED"] = str(seed)
    random.seed(seed)
    np.random.seed(seed)
    tf.random.set_seed(seed)
import numpy as np
def fold_wise_zscore(X_train, X_test):
    mean = np.mean(X_train, axis=0)
    std = np.std(X_train, axis=0)
    std[std == 0] = 1.0
    X_train_norm = (X_train - mean) / std
    X_test_norm = (X_test - mean) / std
    return X_train_norm.astype(np.float32), X_test_norm.astype(np.float32)
import tensorflow as tf
from tensorflow.keras import layers, Model

class RMVAE(Model):
    def __init__(self, input_dim, latent_dim=64, encoder_units=[512, 256],
                 decoder_units=[256, 512], beta=0.5, epsilon=1e-3, **kwargs):
        super().__init__(**kwargs)
        self.latent_dim = latent_dim
        self.beta = beta
        self.epsilon = epsilon

        self.encoder_layers = [layers.Dense(u, activation="relu") for u in encoder_units]
        self.fc_mu = layers.Dense(latent_dim)
        self.fc_logvar = layers.Dense(latent_dim)

        self.decoder_layers = [layers.Dense(u, activation="relu") for u in decoder_units]
        self.fc_out = layers.Dense(input_dim)

    def encode(self, x):
        h = x
        for layer in self.encoder_layers:
            h = layer(h)
        return self.fc_mu(h), self.fc_logvar(h)
    def reparameterize(self, mu, logvar):
        eps = tf.random.normal(shape=tf.shape(mu))
        return mu + tf.exp(0.5 * logvar) * eps

    def decode(self, z):
        h = z
        for layer in self.decoder_layers:
            h = layer(h)
        return self.fc_out(h)
    def call(self, x, training=False):
        mu, logvar = self.encode(x)
        z = self.reparameterize(mu, logvar)
        recon = self.decode(z)
        return recon, mu, logvar, z

    def compute_loss(self, x, recon, mu, logvar):
        recon_loss = tf.reduce_mean(tf.square(x - recon))
        kl_loss = -0.5 * tf.reduce_mean(1 + logvar - tf.square(mu) - tf.exp(logvar))
        return recon_loss + self.beta * kl_loss

