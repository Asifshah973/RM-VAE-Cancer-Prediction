def train_rmvae(model, train_dataset, epochs=100, learning_rate=0.001):
    optimizer = tf.keras.optimizers.Adam(learning_rate=learning_rate, beta_1=0.9, beta_2=0.999, epsilon=1e-8)

    for epoch in range(epochs):
        total_loss = 0.0
        steps = 0
        for x_batch in train_dataset:
            with tf.GradientTape() as tape:
                recon, mu, logvar, z = model(x_batch, training=True)
                loss = model.compute_loss(x_batch, recon, mu, logvar)
            grads = tape.gradient(loss, model.trainable_variables)
            optimizer.apply_gradients(zip(grads, model.trainable_variables))
            total_loss += loss
            steps += 1
        if (epoch + 1) % 10 == 0:
            print(f"RM-VAE Epoch {epoch+1}/{epochs} | Loss: {total_loss/steps:.4f}")
    return model

import tensorflow as tf

def train_dnn(model, train_dataset, epochs=100, learning_rate=0.001):
    optimizer = tf.keras.optimizers.Adam(learning_rate=learning_rate)
    loss_fn = tf.keras.losses.BinaryCrossentropy()

    for epoch in range(epochs):
        total_loss = 0.0
        steps = 0
        for x_batch, y_batch in train_dataset:
            with tf.GradientTape() as tape:
                preds = model(x_batch, training=True)
                loss = loss_fn(y_batch, preds)
            grads = tape.gradient(loss, model.trainable_variables)
            optimizer.apply_gradients(zip(grads, model.trainable_variables))
            total_loss += loss
            steps += 1
        if (epoch + 1) % 10 == 0:
            print(f"DNN Epoch {epoch+1}/{epochs} | Loss: {total_loss/steps:.4f}")
    return model

"""
Main script: RM-VAE + DNN with 10-fold CV
Usage:
    python scripts/run_rmvae.py --dataset breast --data data/breast.csv --config configs/breast.yaml
