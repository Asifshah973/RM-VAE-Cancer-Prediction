import argparse
import yaml
import numpy as np
import pandas as pd
from pathlib import Path
from sklearn.model_selection import StratifiedKFold
import tensorflow as tf

from src.utils.seed import set_seed
from src.preprocessing.normalization import fold_wise_zscore
from src.models.rm_vae import RMVAE
from src.models.dnn import DNNClassifier
from src.training.rmvae_trainer import train_rmvae
from src.training.dnn_trainer import train_dnn

def load_data(path):
    df = pd.read_csv(path)
    if "sample_id" in df.columns:
        df = df.drop(columns=["sample_id"])
    y = df["label"].values.astype(np.float32)
    X = df.drop(columns=["label"]).values.astype(np.float32)
    return X, y

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dataset", required=True, choices=["breast", "lung", "ovarian"])
    parser.add_argument("--data", required=True)
    parser.add_argument("--config", required=True)
    args = parser.parse_args()

    with open(args.config) as f:
        cfg = yaml.safe_load(f)

    set_seed(cfg.get("seed", 1234))

    X, y = load_data(args.data)
    print(f"Data shape: {X.shape} | Labels: {np.unique(y, return_counts=True)}")

    skf = StratifiedKFold(n_splits=cfg.get("n_folds", 10), shuffle=True, random_state=cfg.get("seed", 1234))

    fold_results = []

    for fold, (train_idx, test_idx) in enumerate(skf.split(X, y)):
        print(f"\n===== Fold {fold+1}/10 =====")
        X_train, X_test = X[train_idx], X[test_idx]
        y_train, y_test = y[train_idx], y[test_idx]

        X_train, X_test = fold_wise_zscore(X_train, X_test)

        # RM-VAE
        rmvae = RMVAE(
            input_dim=X_train.shape[1],
            latent_dim=cfg.get("latent_dim", 64),
            encoder_units=cfg.get("encoder_units", [512, 256]),
            decoder_units=cfg.get("decoder_units", [256, 512]),
            beta=cfg.get("beta", 0.5),
            epsilon=cfg.get("geometry_epsilon", 1e-3)
        )

        train_ds = tf.data.Dataset.from_tensor_slices(X_train).shuffle(1000).batch(cfg.get("batch_size", 32))
        rmvae = train_rmvae(rmvae, train_ds, epochs=cfg.get("epochs_rmvae", 100), learning_rate=cfg.get("learning_rate", 0.001))

        # Freeze encoder and extract latent features
        mu_train, _ = rmvae.encode(X_train)
        mu_test, _ = rmvae.encode(X_test)

        # DNN
        dnn = DNNClassifier(input_dim=cfg.get("latent_dim", 64), hidden_units=cfg.get("dnn_units", [128, 64]))
        dnn_train_ds = tf.data.Dataset.from_tensor_slices((mu_train, y_train)).shuffle(1000).batch(cfg.get("batch_size", 32))
        dnn = train_dnn(dnn, dnn_train_ds, epochs=cfg.get("epochs_dnn", 100), learning_rate=cfg.get("learning_rate", 0.001))

        # Evaluation
        preds = dnn(mu_test).numpy().flatten()
        pred_labels = (preds >= 0.5).astype(int)

        from sklearn.metrics import accuracy_score, roc_auc_score, f1_score, precision_score, recall_score
        acc = accuracy_score(y_test, pred_labels)
        auc = roc_auc_score(y_test, preds)
        f1 = f1_score(y_test, pred_labels)
        prec = precision_score(y_test, pred_labels)
        rec = recall_score(y_test, pred_labels)

        print(f"Fold {fold+1} | Acc: {acc:.4f} | AUC: {auc:.4f} | F1: {f1:.4f}")
        fold_results.append({"fold": fold+1, "accuracy": acc, "auc": auc, "f1": f1, "precision": prec, "recall": rec})

    results_df = pd.DataFrame(fold_results)
    out_dir = Path(f"results/{args.dataset}")
    out_dir.mkdir(parents=True, exist_ok=True)
    results_df.to_csv(out_dir / "fold_results.csv", index=False)
    print("\nMean Accuracy:", results_df["accuracy"].mean())
    print("Mean AUC     :", results_df["auc"].mean())

if __name__ == "__main__":
    main()

